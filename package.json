{
  "name": "tcg2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:build": "node scripts/build-seed.mjs",
    "idea:cards": "node scripts/idea-cards.mjs",
    "design:cards": "node scripts/design-cards.mjs",
    "import:cards": "node scripts/import-concept-cards.mjs --upload-art --import ./data/cards",
    "import:dungeons": "node scripts/import-concept-dungeons.mjs --upload-art --import ./data/dungeons",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:fullreset": "npm run db:reset && npm run seed:build && npm run import:cards && npm run import:dungeons",
    "db:types": "supabase gen types typescript --local > src/types/database.gen.ts"
  },
  "dependencies": {
    "@remotion/player": "^4.0.526",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "remotion": "^4.0.526",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
