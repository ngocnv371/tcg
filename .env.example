VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Web push (run `npx web-push generate-vapid-keys`). The public key is safe to bundle; the
# private key is a secret for supabase/functions/notify-runs and must never appear here.
# Leave blank to disable the notification toggle.
VITE_VAPID_PUBLIC_KEY=

# Local stack: `npm run db:start` prints the anon key into the terminal,
# or read it from `npx supabase status`.
# Hosted: Supabase dashboard -> Project Settings -> API.
# Never put the service_role key in a VITE_ variable — anything prefixed with
# VITE_ is bundled into the client.
